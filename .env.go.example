# Copy to .env.go and supply independent random hex keys.
# POSTGRES_PASSWORD must be URI-safe; hex avoids URL escaping.
POSTGRES_PASSWORD=
CHATGPT2API_AUTH_KEY=
CHATGPT2API_ADMIN_KEY=
GO_OAUTH_ENCRYPTION_KEY=
CHATGPT_GO_PORT=31001
GO_PUBLIC_BASE_URL=
GO_IMAGE_ACCOUNT_CONCURRENCY=1
GO_IMAGE_MAX_CONCURRENCY=128
GO_REQUEST_TIMEOUT_SECONDS=180
# Each app/registrar process defaults to 8 database connections. Start one app
# by default; if you scale app replicas, keep the aggregate below PostgreSQL's
# connection limit (for example, 4 app replicas + registrar use at most 40).
GO_DATABASE_MAX_CONNECTIONS=8
TZ=Asia/Shanghai
